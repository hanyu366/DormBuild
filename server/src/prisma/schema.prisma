datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String   @id @default(cuid())
  nickname     String
  passwordHash String
  avatar       String?
  dormId       String?
  dorm         Dorm?   @relation(fields: [dormId], references: [id])
  createdAt    DateTime @default(now())

  expenseSplits  ExpenseSplit[]
  expensesPaid   Expense[]
  dutySchedules  DutySchedule[]
  votesCreated   Vote[]
  voteRecords    VoteRecord[]
  notifications  Notification[]
}

model Dorm {
  id                String   @id @default(cuid())
  name              String
  inviteCode        String   @unique @default(cuid())
  city              String   @default("北京")
  createdAt         DateTime @default(now())

  members           User[]
  expenses          Expense[]
  conventions       Convention[]
  dutySchedules     DutySchedule[]
  votes             Vote[]
  anonymousMessages AnonymousMessage[]
  notifications     Notification[]
  weatherCache      WeatherCache?
}

model Expense {
  id          String   @id @default(cuid())
  dormId      String
  payerId     String
  title       String
  amount      Float
  category    String
  splitMethod String
  note        String?
  createdAt   DateTime @default(now())

  dorm   Dorm   @relation(fields: [dormId], references: [id])
  payer  User   @relation(fields: [payerId], references: [id])
  splits ExpenseSplit[]
}

model ExpenseSplit {
  id        String  @id @default(cuid())
  expenseId String
  userId    String
  amount    Float
  settled   Boolean @default(false)

  expense Expense @relation(fields: [expenseId], references: [id])
  user    User    @relation(fields: [userId], references: [id])
}

model Convention {
  id        String   @id @default(cuid())
  dormId    String
  type      String
  title     String
  content   String
  pinned    Boolean  @default(false)
  priority  Int      @default(0)
  createdBy String
  createdAt DateTime @default(now())

  dorm Dorm @relation(fields: [dormId], references: [id])
}

model DutySchedule {
  id        String   @id @default(cuid())
  dormId    String
  userId    String
  dutyDate  DateTime
  dutyType  String
  completed Boolean  @default(false)

  dorm Dorm @relation(fields: [dormId], references: [id])
  user User @relation(fields: [userId], references: [id])
}

model Vote {
  id          String    @id @default(cuid())
  dormId      String
  title       String
  description String?
  isAnonymous Boolean
  multiChoice Boolean
  deadline    DateTime?
  createdBy   String
  createdAt   DateTime  @default(now())

  dorm    Dorm          @relation(fields: [dormId], references: [id])
  creator User          @relation(fields: [createdBy], references: [id])
  options VoteOption[]
  records VoteRecord[]
}

model VoteOption {
  id      String @id @default(cuid())
  voteId  String
  content String

  vote    Vote         @relation(fields: [voteId], references: [id])
  records VoteRecord[]
}

model VoteRecord {
  id       String  @id @default(cuid())
  voteId   String
  optionId String
  userId   String?

  vote   Vote       @relation(fields: [voteId], references: [id])
  option VoteOption @relation(fields: [optionId], references: [id])
  user   User?      @relation(fields: [userId], references: [id])
}

model AnonymousMessage {
  id        String   @id @default(cuid())
  dormId    String
  content   String
  likes     Int      @default(0)
  createdAt DateTime @default(now())

  dorm Dorm @relation(fields: [dormId], references: [id])
}

model Notification {
  id        String   @id @default(cuid())
  dormId    String
  userId    String?
  type      String
  title     String
  content   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  dorm Dorm  @relation(fields: [dormId], references: [id])
  user User? @relation(fields: [userId], references: [id])
}

model WeatherCache {
  id        String   @id @default(cuid())
  dormId    String   @unique
  city      String
  current   String
  forecast  String
  updatedAt DateTime @updatedAt

  dorm Dorm @relation(fields: [dormId], references: [id])
}
